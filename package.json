{
  "name": "handsoff",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/types",
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "jest --config apps/backend/test/jest-integration.json --runInBand",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "pino": "^9.0.0",
    "pino-http": "^10.0.0"
  }
}
